      "ordinal": 1,
      "latex": "a_v^{(k)} =   {\\rm MAX}\\left( \\left\\{ {\\rm ReLU} \\left(W \\cdot h_u^{(k-1)} \\right), \\  \\forall u \\in \\mathcal{N}(v) \\right\\}\\right),",
      "environment": "align",
      "labels": [
        "eq:graphsage-agg"
      ]
    },
    {
      "ordinal": 2,
      "latex": "h_v^{(k)} =   {\\rm ReLU} \\left(W \\cdot {\\rm MEAN} \\left\\{h_u^{(k-1)},\\ \\forall u \\in \\mathcal{N}(v) \\cup \\{v\\} \\right\\} \\right).",
      "environment": "align",
