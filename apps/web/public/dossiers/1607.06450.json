      "environment": "equation",
      "labels": []
    },
    {
      "ordinal": 4,
      "latex": "LN({\\bf z} ; \\bm{\\alpha}, \\bm{\\beta}) = \\frac{({\\bf z} - \\mu)}{\\sigma} \\odot \\bm{\\alpha} + \\bm{\\beta}, \\\\\n\\mu = \\frac{1}{D}\\sum_{i=1}^D z_i, \\quad \\sigma = \\sqrt{\\frac{1}{D}\\sum_{i=1}^D (z_i-\\mu)^2},",
