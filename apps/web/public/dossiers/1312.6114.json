      "latex": "\\btz = \\gPhi(\\beps,\\bx) \\text{\\quad with \\quad} \\beps \\sim p(\\beps)\n\\eqnr",
      "environment": "align*",
      "labels": []
    },
    {
      "ordinal": 22,
      "latex": "\\mathcal{L}(\\bT,\\bphi;\\bxi)\n&= \\int \\qPhi(\\bz|\\bx) \\left(\\log \\pT(\\bxi | \\bz) + \\log \\pT(\\bz) - \\log \\qPhi(\\bz|\\bx)\\right) \\,d\\bz \\\\\n&= \\int p(\\beps) \\left(\\log \\pT(\\bxi | \\bz) + \\log \\pT(\\bz) - \\log \\qPhi(\\bz|\\bx)\\right) \\bigg|_{\\bz=\\gPhi(\\beps,\\bxi)} \\,d\\beps\n\\eqnr",
