      "labels": []
    },
    {
      "ordinal": 1,
      "latex": "\\log \\pT(\\bxi) \\geq \\LB{}{\\bxi}\n&= \\Exp{\\qPhi(\\bz|\\bx)}{- \\log \\qPhi(\\bz|\\bx) + \\log \\pT(\\bx,\\bz)}\n\\eqnr",
      "environment": "align*",
      "labels": [
        "eq:lowerbound"
      ]
    },
    {
      "ordinal": 2,
      "latex": "\\LB{}{\\bxi} = - D_{KL}(\\qPhi(\\bz|\\bxi) || \\pT(\\bz)) + \\Exp{\\qPhi(\\bz|\\bxi)}{\\log \\pT(\\bxi | \\bz)}\n\\eqnr",
      "environment": "align*",
      "labels": [
        "eq:lowerbound2"
      ]
    },
    {
      "ordinal": 3,
      "latex": "\\btz = \\gPhi(\\beps,\\bx) \\text{\\quad with \\quad} \\beps \\sim p(\\beps)\n\\eqnr",
      "environment": "align*",
      "labels": []
    },
    {
      "ordinal": 4,
      "latex": "\\Exp{\\qPhi(\\bz|\\bxi)}{f(\\bz)}\n= \\Exp{p(\\beps)}{f(\\gPhi(\\beps,\\bxi))}\n&\\simeq \\frac{1}{L} \\sum_{l=1}^L {f(\\gPhi(\\bepsl,\\bxi))}\n \\text{\\quad where \\quad} \\bepsl \\sim p(\\beps)",
      "environment": "align",
      "labels": []
    },
    {
      "ordinal": 5,
      "latex": "\\LBT{A}{\\bxi}\n&= \\frac{1}{L} \\sum_{l=1}^L \n\\log \\pT(\\bxi, \\bzil) - \\log \\qPhi(\\bzil|\\bxi) \\\\\n\\text{where \\quad} \\bzil &= \\gPhi(\\bepsil,\\bxi)\n\\text{\\quad and \\quad} \\bepsl \\sim p(\\beps)\n\\eqnr",
      "environment": "align*",
      "labels": [
        "eq:fullestimator"
      ]
    },
    {
      "ordinal": 6,
      "latex": "\\LBT{B}{\\bxi}\n&= - D_{KL}(\\qPhi(\\bz|\\bxi) || \\pT(\\bz))\n+ \\frac{1}{L} \\sum_{l=1}^L (\\log \\pT(\\bxi|\\bzil)) \\\\\n\\text{where \\quad} \\bzil &= \\gPhi(\\bepsil,\\bxi)\n\\text{\\quad and \\quad} \\bepsl \\sim p(\\beps)\n\\eqnr",
      "environment": "align*",
      "labels": [
        "eq:estimator2"
      ]
    },
    {
      "ordinal": 7,
      "latex": "\\LB{}{\\bX} \\simeq \\LBT{M}{\\bX^M} = \\frac{N}{M} \\sum_{i=1}^M \\LBT{}{\\bxi}\n\\eqnr",
      "environment": "align*",
      "labels": [
        "eq:minibatchestimator"
      ]
    },
    {
      "ordinal": 8,
      "latex": "\\log \\qPhi(\\bz|\\bxi)\n&= \\log \\mathcal{N}(\\bz; \\bmu^{(i)}, \\bsigma^{2 (i)} \\bI)\n\\eqnr",
      "environment": "align*",
      "labels": []
    },
    {
      "ordinal": 9,
      "latex": "\\LB{}{\\bxi}\n&\\simeq \n\\frac{1}{2} \\sum_{j=1}^J \\left(1 + \\log ((\\sigma_j^{(i)})^2) - (\\mu_j^{(i)})^2 - (\\sigma_j^{(i)})^2 \\right)\n+ \\frac{1}{L} \\sum_{l=1}^L \\log \\pT(\\bxi|\\bzil) \\\\\n\\text{where\\quad}\n\\bzil &= \\bmu^{(i)} + \\bsigma^{(i)} \\odot \\beps^{(l)}\n\\text{\\quad and \\quad}\n\\bepsl \\sim \\mathcal{N}(0,\\bI)\n\\eqnr",
      "environment": "align*",
      "labels": [
        "eq:gaussian_estimator"
      ]
    },
    {
      "ordinal": 10,
      "latex": "\\int \\qT(\\bz) \\log p(\\bz) \\,d\\bz\n&= \\int \\mathcal{N}(\\bz;\\bmu,\\bsigma^2) \\log \\mathcal{N}(\\bz;\\bzero,\\bI) \\,d\\bz \\\\\n&=  - \\frac{J}{2} \\log (2 \\pi) - \\frac{1}{2} \\sum_{j=1}^J (\\mu_j^2 + \\sigma_j^2)",
      "environment": "align*",
      "labels": []
    },
    {
      "ordinal": 11,
      "latex": "\\int \\qT(\\bz) \\log \\qT(\\bz) \\,d\\bz\n&= \\int \\mathcal{N}(\\bz;\\bmu,\\bsigma^2) \\log \\mathcal{N}(\\bz;\\bmu,\\bsigma^2) \\,d\\bz \\\\\n&= - \\frac{J}{2} \\log (2 \\pi) - \\frac{1}{2} \\sum_{j=1}^J ( 1 + \\log \\sigma^2_j )",
      "environment": "align*",
      "labels": []
    },
    {
      "ordinal": 12,
      "latex": "- D_{KL}((\\qPhi(\\bz) || \\pT(\\bz)) &= \\int \\qT(\\bz) \\left(\\log \\pT(\\bz) - \\log \\qT(\\bz)\\right) \\,d\\bz \\\\\n&= \\frac{1}{2} \\sum_{j=1}^J \\left(1 + \\log ((\\sigma_j)^2) - (\\mu_j)^2 - (\\sigma_j)^2 \\right)",
      "environment": "align*",
      "labels": []
    },
    {
      "ordinal": 13,
      "latex": "\\log p(\\bx|\\bz)\n&= \\sum_{i=1}^D x_i \\log y_i + (1-x_i) \\cdot \\log(1-y_i) \\\\\n\\text{where\\,\\,\\,}\n\\by &= f_\\sigma(\\bW_2 \\tanh(\\bW_1 \\bz + \\bbb_1) + \\bbb_2)\n\\eqnr",
      "environment": "align*",
      "labels": []
    },
    {
      "ordinal": 14,
      "latex": "\\log p(\\bx|\\bz)\n&= \\log \\mathcal{N}(\\bx; \\bmu, \\bsigma^2 \\bI)\n\\\\\n\\text{where\\,\\,\\,}\n\\bmu &= \\bW_4 \\bh  +\\bbb_4 \\\\\n\\log \\bsigma^2 &= \\bW_5 \\bh + \\bbb_5 \\\\\n\\bh &= \\tanh(\\bW_3 \\bz + \\bbb_3)\n\\eqnr",
      "environment": "align*",
      "labels": []
    },
    {
      "ordinal": 15,
      "latex": "\\pT(\\bxi) \\simeq \\left( \\frac{1}{L} \\sum_{l=1}^L \\frac{q(\\bzl)}{\\pT(\\bz) \\pT(\\bxi|\\bzl)} \\right)^{-1} \\text{\\quad where \\quad} \\bzl \\sim \\pT(\\bz|\\bxi)",
      "environment": "align*",
      "labels": []
    },
    {
      "ordinal": 16,
      "latex": "\\frac{1}{\\pT(\\bxi)} \n&= \\frac{\\int q(\\bz) \\,d\\bz}{\\pT(\\bxi)}\n= \\frac{\\int q(\\bz) \\frac{\\pT(\\bxi, \\bz) }{\\pT(\\bxi, \\bz)} \\,d\\bz}{\\pT(\\bxi)} \\\\\n&= \\int \\frac{\\pT(\\bxi, \\bz)}{\\pT(\\bxi)} \\frac{q(\\bz)}{\\pT(\\bxi, \\bz)} \\,d\\bz \\\\\n&= \\int \\pT(\\bz|\\bxi) \\frac{q(\\bz)}{\\pT(\\bxi, \\bz)} \\,d\\bz \\\\\n&\\simeq \\frac{1}{L} \\sum_{l=1}^L \\frac{q(\\bzl)}{\\pT(\\bz) \\pT(\\bxi|\\bzl)} \\text{\\quad where \\quad} \\bzl \\sim \\pT(\\bz|\\bxi)",
      "environment": "align*",
      "labels": []
    },
    {
      "ordinal": 17,
      "latex": "\\log \\pA(\\bX) = D_{KL}(\\qPhi(\\bT)||\\pA(\\bT|\\bX)) + \\mathcal{L}(\\bphi;\\bX)\n\\eqnr",
      "environment": "align*",
      "labels": []
    },
    {
      "ordinal": 18,
      "latex": "\\mathcal{L}(\\bphi;\\bX) = \\int \\qPhi(\\bT) \\left( \\log \\pT(\\bX) + \\log \\pA(\\bT) - \\log \\qPhi(\\bT) \\right) \\,d\\bT\n\\eqnr",
      "environment": "align*",
      "labels": [
        "eq:lowerbound1_ap"
      ]
    },
    {
      "ordinal": 19,
      "latex": "\\log \\pT(\\bxi) = D_{KL}(\\qPhi(\\bz|\\bxi)||\\pT(\\bz|\\bxi)) + \\mathcal{L}(\\bT,\\bphi;\\bxi)\n\\eqnr",
      "environment": "align*",
      "labels": []
    },
    {
